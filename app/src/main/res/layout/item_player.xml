<?xml version="1.0" encoding="utf-8"?>
<!-- Ficha estilizada de jugador estilo cromo/estampita retro -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/retro_green_pitch"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:strokeColor="@color/retro_yellow_bright"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <!-- Imagen con esquinas redondeadas retro usando ShapeableImageView -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgPlayer"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            android:background="@color/retro_cream_background"
            android:padding="4dp"
            app:shapeAppearanceOverlay="@style/RetroImageStyle" />

        <LinearLayout
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/tvPlayerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre Jugador"
                android:textColor="@color/retro_yellow_bright"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvPlayerPosition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Posición"
                android:textColor="@color/retro_cream_background"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvPlayerNationality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nacionalidad"
                android:textColor="#A0A0A0"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>