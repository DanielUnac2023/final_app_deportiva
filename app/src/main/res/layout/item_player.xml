<?xml version="1.0" encoding="utf-8"?>
<!-- Archivo XML de diseño para la ficha de jugador, muestra la foto del
     jugador y sus datos principales: nombre, posición y nacionalidad.
     Se utiliza como vista personalizada en el RecyclerView de jugadores y
     en el diálogo de detalle del jugador. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginVertical="4dp"
    android:background="@color/retro_green_pitch"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/imgPlayer"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_gallery"
        android:background="@color/retro_cream_background"
        android:padding="2dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvPlayerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre Jugador"
            android:textColor="@color/retro_yellow_bright"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPlayerPosition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Posición"
            android:textColor="@color/retro_cream_background"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvPlayerNationality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nacionalidad"
            android:textColor="#A0A0A0"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>