<?xml version="1.0" encoding="utf-8"?>
<!-- Fila estilizada de la tabla de posiciones con estilo marcador retro -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="3dp"
    app:cardBackgroundColor="@color/retro_green_pitch"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/retro_yellow_accent"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Posición / Ranking -->
        <TextView
            android:id="@+id/tvRank"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:textColor="@color/retro_yellow_bright"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:text="1" />

        <!-- Separador vertical retro -->
        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:background="@color/retro_yellow_accent"
            android:layout_marginEnd="10dp" />

        <!-- Nombre del Equipo -->
        <TextView
            android:id="@+id/tvTableTeam"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/retro_cream_background"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Equipo" />

        <!-- Partidos Jugados (PJ) -->
        <TextView
            android:id="@+id/tvPlayed"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:textColor="@color/retro_cream_background"
            android:textSize="14sp"
            android:gravity="center"
            android:text="PJ" />

        <!-- Puntos (PTS) -->
        <TextView
            android:id="@+id/tvPoints"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:textColor="@color/retro_yellow_bright"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:text="PTS" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>