<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="40dp"
    android:background="@color/retro_green_dark">

    <!-- Título Retro -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FOOTBALL CLUB"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/retro_yellow_bright"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Campo de Búsqueda -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/etSearchTeam"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Nombre del equipo..."
            android:textColorHint="#A0A0A0"
            android:textColor="@color/retro_green_dark"
            android:background="@color/retro_cream_background"
            android:padding="12dp"
            android:inputType="text" />

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BUSCAR"
            android:textStyle="bold"
            android:backgroundTint="@color/retro_yellow_bright"
            android:textColor="@color/retro_green_dark"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Indicador de Carga -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Nombre del equipo encontrado y botones de opción -->
    <LinearLayout
        android:id="@+id/layoutTeamInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@color/retro_green_pitch"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvTeamName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre Equipo"
            android:textColor="@color/retro_yellow_bright"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnViewPlayers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Jugadores"
                android:backgroundTint="@color/retro_yellow_accent"
                android:textColor="@color/retro_green_dark"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnViewTable"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tabla Liga"
                android:backgroundTint="@color/retro_yellow_accent"
                android:textColor="@color/retro_green_dark"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Encabezado de Columnas para la Tabla (Retro Header) -->
    <LinearLayout
        android:id="@+id/layoutTableHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:background="@color/retro_green_dark"
        android:visibility="gone">

        <TextView
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:text="POS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/retro_yellow_bright"
            android:gravity="center" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="11dp"
            android:text="EQUIPO"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/retro_yellow_bright" />

        <TextView
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:text="PJ"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/retro_yellow_bright"
            android:gravity="center" />

        <TextView
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:text="PTS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/retro_yellow_bright"
            android:gravity="center" />
    </LinearLayout>

    <!-- RecyclerView para la lista de resultados -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>